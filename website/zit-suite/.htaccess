# ZIT-Suite homepage — https://zsync.eu/zit-suite/
# Apache 2.4. Every block is guarded with <IfModule>, so a missing module never breaks the site.

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset utf-8

# ---- Types -------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>

# ---- HTTPS + canonical folder URL ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (also behind a proxy that sets X-Forwarded-Proto).
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # /zit-suite/index.html -> /zit-suite/  (one canonical URL for search engines)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /zit-suite/$1 [R=301,L]
</IfModule>

# ---- Security headers -------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # The page is fully self-contained: no third-party scripts, fonts or trackers.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

# ---- Caching ------------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Compression ---------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# ---- Hide repo/dev files if they ever get uploaded ------------------------------------------------
<FilesMatch "(^\.|\.(md|log|bak|sh)$)">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>
