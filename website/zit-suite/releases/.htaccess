# ZIT-Suite downloads — https://zsync.eu/zit-suite/releases/
# Installers live in releases/assets/. Everything here is served as a file download, never executed.

Options -Indexes -ExecCGI
DirectoryIndex disabled

# Nothing in here may run as a script on the server.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh

# Correct types for the installers.
<IfModule mod_mime.c>
  AddType application/vnd.microsoft.portable-executable .exe
  AddType application/x-msi .msi
  AddType application/vnd.debian.binary-package .deb
  AddType application/x-rpm .rpm
  AddType application/vnd.appimage .AppImage
  AddType text/plain .txt .sha256 .sig
</IfModule>

# Always download (Save as…) instead of opening in the browser, with the real file name.
<IfModule mod_headers.c>
  <FilesMatch "\.(exe|msi|deb|rpm|AppImage|zip|tar\.gz|sig)$">
    ForceType application/octet-stream
    Header set Content-Disposition "attachment"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(txt|sha256)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The homepage reads file sizes and checksums from here.
  Header set Access-Control-Allow-Origin "https://zsync.eu"
  Header set Access-Control-Expose-Headers "Content-Length"
</IfModule>

# No compression for already-compressed installers (keeps Content-Length + resumable downloads).
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.(exe|msi|deb|rpm|AppImage|zip|gz)$" no-gzip dont-vary
</IfModule>

<Files ".htaccess">
  Require all denied
</Files>
