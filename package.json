{
  "name": "zit-suite",
  "private": true,
  "version": "0.2.0",
  "description": "Free, open-source GitHub desktop app for Linux and Windows: manage every repository at once — bulk actions with dry run, cross-repo issues & pull requests, Actions CI board, releases, security, insights and built-in Git.",
  "author": {
    "name": "TheHolyOneZ",
    "url": "https://github.com/TheHolyOneZ"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://zsync.eu/zit-suite/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHolyOneZ/ZIT-Suite.git"
  },
  "bugs": {
    "url": "https://github.com/TheHolyOneZ/ZIT-Suite/issues"
  },
  "keywords": [
    "github",
    "github-client",
    "repository-manager",
    "bulk-actions",
    "git-gui",
    "desktop-app",
    "tauri",
    "rust",
    "react",
    "github-actions",
    "developer-tools",
    "linux",
    "windows"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n-check.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm test"
  },
  "dependencies": {
